# Godot 4+ specific ignores
.godot/
.import/
/android/

# Build outputs / publish artifacts (exported binaries are outputs, not inputs)
*.pck
*.exe
shmup-*.zip

# Mono / C# build output (vestigial — project never used C#, consolidated off Mono 2026-05-26)
.mono/
mono_crash.*.json

# Editor autosaves (per CLAUDE.md — Godot leftovers)
*.tmp

# Local credentials
export_credentials.cfg

# Capture artifacts (Anvil/Claude screencaps + GIFs)
/captures/

# Godot CSV-as-translation import artifacts (docs/weapon_stats.csv is a report,
# not a real translation source — these regenerate on every project open)
docs/*.translation

# Sim output dumps (regenerable; the sim_*.gd tools are tracked, their text output isn't)
sim_out.txt
sim_stream_out.txt

# Test-harness PASS-marker dumps (written by tools/test_*.gd, never read by anything)
tools/_*_result.txt

# OS / IDE
Thumbs.db
.DS_Store
.vs/
.vscode/
*.swp

# Windows Explorer cruft
desktop.ini
