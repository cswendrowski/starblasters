config/version="0.1.110"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://Mini Pixel Pack 3/UI objects/Player_life_icon (16 x 16).png"

[autoload]

