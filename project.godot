; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"Ã¯Â»Â¿config_version"=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Classic Shmup"
config/version="0.1.96"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://Mini Pixel Pack 3/UI objects/Player_life_icon (16 x 16).png"

[autoload]

Run="*res://scripts/run_state.gd"
Dbg="*res://scripts/dbg.gd"
Music="*res://scripts/music_manager.gd"
Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Classic Shmup"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/terrain_autotiler/plugin.cfg")

