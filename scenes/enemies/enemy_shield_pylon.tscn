[gd_scene load_steps=5 format=3 uid="uid://bshldpylon001"]

; Shield Pylon scene used by boss_aegis. The ROOT runs aegis_pylon.gd (the
; proven pylon mechanic: hp/max_hp/side + pylon_killed signal). Aegis instances
; this scene, sets hp/side, connects the signal.
[ext_resource type="Script" uid="uid://d3x2m0dru5n7n" path="res://scripts/enemies/aegis_pylon.gd" id="1_script"]
[ext_resource type="Texture2D" uid="uid://dxo2261cbxwx0" path="res://graphics/enemies/enemy_shield_pylon.png" id="2_body"]
[ext_resource type="Texture2D" uid="uid://66uvb8vtaltt" path="res://graphics/enemies/enemy_shield_pylon_orb.png" id="3_orb"]
[ext_resource type="AudioStream" uid="uid://cai1gm5ivl0tn" path="res://assets/audio/SFX_creatureDie4.wav" id="4_die"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_pylon"]
size = Vector2(16, 16)

[node name="ShieldPylon" type="Area2D" groups=["enemies"]]
script = ExtResource("1_script")

; BODY — shows the new pylon art, frame 0 only (designer trims the sheet to one
; frame later; hframes=4 keeps the import valid in the meantime). The damage-
; overlay shader is installed on THIS node by aegis_pylon.gd in _ready(); it
; frays/darkens as the pylon loses HP. NO material line here on purpose: the
; install early-returns if a material already exists.
[node name="Sprite2D" type="Sprite2D" parent="."]
texture = ExtResource("2_body")
hframes = 4
frame = 0

; ORB — declared AFTER the body so it draws ON TOP ("orb over the pylon").
; aegis_pylon.gd cycles its 4 hframes on a loop and stops/frees it on death.
; NO material so the damage shader never touches it — the orb stays bright.
[node name="Orb" type="Sprite2D" parent="."]
texture = ExtResource("3_orb")
hframes = 4
frame = 0

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_pylon")

[node name="EnemyDie" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("4_die")
