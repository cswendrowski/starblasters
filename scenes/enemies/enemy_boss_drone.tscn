[gd_scene load_steps=4 format=3 uid="uid://bbossdrone001"]

; Boss Drone — minimal damageable drone, placeholder art. The designer will
; swap the texture and flesh out behavior (movement/shoot Resource slots) in a
; later follow-up. For now it just needs to exist + load + take damage. Uses
; enemy_core.gd so the movement/shoot slots are already present and empty.
; Stats are set as @export overrides below (the normal core-enemy convention,
; NOT the boss "stats in _ready() before super" pattern) — no fallback exprs.
[ext_resource type="Script" uid="uid://c2jua6ov70wm4" path="res://scripts/enemies/enemy_core.gd" id="1_core"]
[ext_resource type="Texture2D" uid="uid://br6btvch0he8" path="res://graphics/enemies/enemy_placeholder_16x.png" id="2_tex"]
[ext_resource type="AudioStream" uid="uid://cai1gm5ivl0tn" path="res://assets/audio/SFX_creatureDie4.wav" id="3_die"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_drone"]
size = Vector2(16, 16)

; GUESS (designer to confirm): 6 HP / 2 bounty — a small expendable add. No
; movement or shoot pattern wired (slots left null) so it sits still until the
; designer gives it behavior.
[node name="BossDrone" type="Area2D" groups=["enemies"]]
script = ExtResource("1_core")
max_health = 6
bounty_value = 2

[node name="Sprite2D" type="Sprite2D" parent="."]
texture = ExtResource("2_tex")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_drone")

[node name="EnemyDie" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("3_die")

